# JanSeva Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set to your MongoDB connection string (e.g., mongodb://127.0.0.1:27017/janseva)
# If local MongoDB is not running, the backend automatically uses mongodb-memory-server for zero-setup demo
MONGODB_URI=mongodb://127.0.0.1:27017/janseva

# JWT Secret Keys
JWT_SECRET=janseva_smart_citizen_complaint_management_system_jwt_secret_2026

# Citizen Authentication (Demo OTP)
DEMO_OTP_ENABLED=true
DEMO_OTP=123456

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Geocoding Service (optional API key if using custom reverse geocoder, defaults to OpenStreetMap Nominatim)
NOMINATIM_USER_AGENT=JanSevaCitizenApp/1.0
